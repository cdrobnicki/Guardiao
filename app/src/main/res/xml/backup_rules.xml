<?xml version="1.0" encoding="utf-8"?>
<!--
  Regras para Android 11 e anteriores. Como android:allowBackup é false, nada é copiado de
  qualquer forma; o arquivo existe para a configuração ficar explícita.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
